{
  "$schema": "https://opencode.ai/config.json",

  // Global instructions live in ~/.config/opencode/AGENTS.md. The V1
  // "instructions" config field is accepted by V2 but never resolved.

  // Ordered rules, last match wins. The V2 base policy already allows all
  // actions; these make the V1 "tools"/"permission" intent explicit.
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ]
}
