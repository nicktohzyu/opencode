{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "tools": {
    "websearch": true,
    "webfetch": true
  },
  "instructions": [
    "~/.config/opencode/instructions/safety.md",
    "~/.config/opencode/instructions/style.md",
    "~/.config/opencode/instructions/parallelism.md",
    "~/.config/opencode/instructions/interaction.md"
  ],
  "permission": {
    "websearch": "allow",
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
